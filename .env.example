# === Cổng lắng nghe (Local Docker) ===
PORT_FE=3000
PORT_BE=8000
PORT_AI=8001

# === Đường dẫn Backend gọi sang AI Service ===
# Local Docker: http://ai-service:8001
# Public/Tunnel: https://stroke-ai-service.onrender.com
AI_SERVICE_URL=http://ai-service:8001

# === Đường dẫn Frontend gọi sang Backend API ===
# Local Docker: http://localhost:8000
# Public/Tunnel: https://stroke-backend.onrender.com
API_URL=http://localhost:8000

# === Chuỗi kết nối CSDL MongoDB Atlas ===
# KHÔNG commit giá trị thật của biến này lên Git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stroke_risk?retryWrites=true&w=majority

# === CORS cho Backend (đặt domain Frontend thật khi deploy public) ===
CORS_ORIGIN=*
